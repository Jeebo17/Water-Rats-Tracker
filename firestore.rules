rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function hasValidLeaderLists(data) {
      return (
        (!data.keys().hasAny(['leaderNames']) || data.leaderNames is list) &&
        (!data.keys().hasAny(['declinedLeaderNames']) || data.declinedLeaderNames is list)
      );
    }

    /* ============================
       AUTH COLLECTION
       ============================ */
    match /auth/{docId} {
      // Anyone can read the password (since you're doing it client-side anyway)
      allow read: if true;

      // Absolutely no client writes
      allow write: if false;
    }

    /* ============================
       SESSIONS COLLECTION
       ============================ */
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if request.auth != null && hasValidLeaderLists(request.resource.data);
      allow delete: if request.auth != null;
    }
    
    match /leaders/{leaderId} {
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    match /forms/{formId} {
      allow write: if false;

      match /submissions/{submissionId} {
        allow read: if true; 
        allow write: if true;
      }
    }


    /* ============================
       DEFAULT DENY
       ============================ */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
